  "keywords": [
    "mcp",
    "model-context-protocol",
    "codix",
    "codinfy",
    "scaffolding",
    "ai-agents",
    "smart-context",
    "token-saver",
    "laravel",
    "nextjs",
    "flutter",
    "wordpress",
    "saas",
    "marketplace",
    "cpanel"
  ],
  "license": "MIT",
  "author": "RAFLOX SAS <contact@codinfy.com> (https://codinfy.com)",
  "homepage": "https://docs.codinfy.com/codix-build-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bakalagoin/codix-build-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/bakalagoin/codix-build-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codix-build-mcp": "dist/index.js"
  },
  "files": [
    "dist",
