# Optional: authenticated mode unlocks higher rate limits and access to
# Codinfy team templates. Get one at:
#   https://codinfy.com/admin/parametres/api-s
# Prefix: pk_live_... or pk_sandbox_...
CODIX_BUILD_API_KEY=

# Optional: override the Codinfy template / prompt registry
# CODIX_BUILD_REGISTRY_URL=https://registry.codinfy.com/codix-build

# Optional: request timeout in ms (default 15000)
# CODIX_BUILD_TIMEOUT_MS=15000
